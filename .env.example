# Variables for the Next.js app in web/: copy web/.env.example to web/.env.local.
# The Python POC at the repo root does not read this file (see README, "Démarrer").
# Server-only: never prefix these with NEXT_PUBLIC_. Every key is optional (demo mode without them).

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede

LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_SANDBOX=true
LIVEAVATAR_SANDBOX_VOICE=Charon
LIVEAVATAR_MAX_SESSION_SECONDS=

SESSION_SECRET=
ALLOW_DEMO_LOGIN=
PUBLIC_DEMO=

RESEND_API_KEY=
RESEND_FROM=

USE_MOCK_DB=true
MOCK_DB_PERSIST=true
DATABASE_URL=
DATABASE_SSL=false
PUBLIC_APP_URL=
RECRUITAI_DATA_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Dokploy MCP (Cursor: .cursor/mcp.json loads these from .env via envFile) ---
# Create a key in Dokploy → Settings → Profile → API/CLI Keys.
DOKPLOY_URL=
DOKPLOY_API_KEY=
# Optional. If the panel is behind Cloudflare Access, set a JSON object of headers, e.g.
# {"CF-Access-Client-Id":"...","CF-Access-Client-Secret":"..."}
# DOKPLOY_CUSTOM_HEADERS=

