# Variables for the Next.js app in web/: copy web/.env.example to web/.env.local.
# The Python POC at the repo root does not read this file (see README, "Démarrer").
# Server-only: never prefix these with NEXT_PUBLIC_. Every key is optional (demo mode without them).

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede

LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_SANDBOX=true
LIVEAVATAR_SANDBOX_VOICE=Charon
LIVEAVATAR_MAX_SESSION_SECONDS=

SESSION_SECRET=
ALLOW_DEMO_LOGIN=
PUBLIC_DEMO=

RESEND_API_KEY=
RESEND_FROM=

USE_MOCK_DB=true
MOCK_DB_PERSIST=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
