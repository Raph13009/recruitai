# Daily dump + restore self-test + optional age-encrypted upload to Cloudflare R2.
FROM postgres:16-alpine
RUN apk add --no-cache bash curl tar gzip age aws-cli \
  && age --version \
  && aws --version
WORKDIR /backup
COPY deploy/docker/backup-loop.sh /backup/backup-loop.sh
COPY deploy/docker/offsite-sync.sh /backup/offsite-sync.sh
RUN chmod +x /backup/backup-loop.sh /backup/offsite-sync.sh
ENTRYPOINT ["/bin/sh", "/backup/backup-loop.sh"]
