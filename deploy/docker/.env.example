# Dokploy Compose environment for RecruitAI test stack (never commit real secrets).
POSTGRES_DB=recruitai
POSTGRES_USER=recruitai
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 32
SESSION_SECRET=
TRAEFIK_HOST=recruitai-test.boostaiconsulting.com
PUBLIC_APP_URL=https://recruitai-test.boostaiconsulting.com
ALLOW_DEMO_LOGIN=false
PUBLIC_DEMO=true
BACKUP_KEEP_DAYS=14
# Wipe only on empty/forced re-import. Migrator refuses wipe when data already exists
# unless FORCE_MIGRATE=true.
MIGRATE_WIPE=true
FORCE_MIGRATE=false
# Read-only Supabase Cloud credentials for the migrate job only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_SANDBOX=true
RESEND_API_KEY=
RESEND_FROM=RecruitAI <onboarding@resend.dev>
# Password-reset verification one-shot (auth-verify). Keep false unless you intend to email users.
SEND_RESET_EMAIL=false
AUTH_VERIFY_LIMIT=3
# Cloudflare R2 offsite (optional — see deploy/docs/R2-BACKUPS.md)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AGE_RECIPIENT=
OFFSITE_KEEP_DAYS=30
BACKUP_ALERT_TO=
