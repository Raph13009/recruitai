# Dokploy Compose environment for RecruitAI test stack (never commit real secrets).
POSTGRES_DB=recruitai
POSTGRES_USER=recruitai
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 32
SESSION_SECRET=
TRAEFIK_HOST=recruitai-test.boostaiconsulting.com
PUBLIC_APP_URL=https://recruitai-test.boostaiconsulting.com
ALLOW_DEMO_LOGIN=false
PUBLIC_DEMO=true
BACKUP_KEEP_DAYS=14
# First deploy on empty test DB: wipe+import from Supabase (read-only).
MIGRATE_WIPE=true
# Read-only Supabase Cloud credentials for the migrate job only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
LIVEAVATAR_API_KEY=
LIVEAVATAR_SANDBOX=true
RESEND_API_KEY=
RESEND_FROM=RecruitAI <onboarding@resend.dev>
