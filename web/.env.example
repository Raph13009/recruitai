# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local and fill in. Aliases google_api_key / liveavatar are also read.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede

LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
# Sandbox stays on unless you explicitly set it to false.
LIVEAVATAR_SANDBOX=true
# Needed for avatar mode (LiveAvatar Gemini connector): secret holding the Gemini key, optional context with the prompt.
LIVEAVATAR_GEMINI_SECRET_ID=
LIVEAVATAR_CONTEXT_ID=

# In-memory mock database (Supabase not wired yet).
USE_MOCK_DB=true
