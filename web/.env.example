# Copy to .env.local and fill in. Server-only: never prefix these with NEXT_PUBLIC_.
# Every key is optional. With none of them, the app runs in demo mode: a scripted interviewer with
# the browser's voice, and a local demo database.

# --- Voice: the interviewer's brain and voice (real-time, interruptible) ---
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Default voice for new agencies (each agency can pick its own in Réglages).
GEMINI_VOICE=Aoede

# --- Face: photoreal video avatar, lip-synced on the voice (LiveAvatar, LITE mode) ---
LIVEAVATAR_API_KEY=
# Default avatar when an agency has not picked one (needed outside the sandbox).
LIVEAVATAR_AVATAR_ID=
# Sandbox stays on unless you set it to false: test face "Wayne", ~1 minute sessions, no credits used.
LIVEAVATAR_SANDBOX=true
# Voice used with the sandbox face, so face and voice match.
LIVEAVATAR_SANDBOX_VOICE=Charon
# Optional cap per avatar session, in seconds (must not exceed your LiveAvatar plan's limit).
LIVEAVATAR_MAX_SESSION_SECONDS=

# --- Accounts ---
# Signs the recruiter session cookie. Required on serverless hosts; generated locally otherwise.
# openssl rand -base64 32
SESSION_SECRET=
# One-click access to the demo agency on the sign-in page (default: on in dev, off in production).
ALLOW_DEMO_LOGIN=
# Public "Essayer l'entretien" page (default: on). It can spend voice and avatar credits.
PUBLIC_DEMO=
# Public origin for absolute links (password reset, branding). e.g. https://recruitai.boostaiconsulting.com
PUBLIC_APP_URL=

# --- Email invitations (Resend). Without a key, invitations still create links; email is skipped. ---
RESEND_API_KEY=
# Verified sender, e.g. RecruitAI <onboarding@resend.dev> for sandbox tests.
RESEND_FROM=

# --- Data (priority: mock → private Postgres → Supabase Cloud legacy) ---
# true (default): local demo database, saved to web/.data/store.json in local development.
USE_MOCK_DB=true
MOCK_DB_PERSIST=true
# Private PostgreSQL (Option A / Dokploy). Preferred when USE_MOCK_DB=false.
DATABASE_URL=
# Set true only if the private PG endpoint requires TLS with a non-public CA.
DATABASE_SSL=false
# Directory for branding files + mock store (Docker: /data).
RECRUITAI_DATA_DIR=
# Legacy Supabase Cloud (kept during migration; not part of the final architecture).
SUPABASE_URL=
# Server-only key (bypasses RLS): the server scopes every query by agency itself.
SUPABASE_SERVICE_ROLE_KEY=
